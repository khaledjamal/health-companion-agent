# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Database (User Data & History)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=health_companion
POSTGRES_USER=admin
POSTGRES_PASSWORD=<password>

# PostgreSQL Vector Store (Knowledge Base with Embeddings)
# You can use the same database or separate databases
POSTGRES_VECTOR_HOST=localhost
POSTGRES_VECTOR_PORT=5432
POSTGRES_VECTOR_DB=health_companion_vectors
POSTGRES_VECTOR_USER=admin
POSTGRES_VECTOR_PASSWORD=<password>

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider (openai or ollama)
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=<key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Ollama Settings (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Agent Configuration
MAX_AGENT_ITERATIONS=10
AGENT_VERBOSE=true

# Application Settings
DEFAULT_USER_ID=1
KNOWLEDGE_BASE_DIR=data/knowledge_base